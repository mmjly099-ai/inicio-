  "firestore": {
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Store workspace root owned by user."
    },
    "/workspaces/{workspaceId}/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/Campaign" },
      "description": "Campaigns inside a workspace."
    },
    "/workspaces/{workspaceId}/metrics/{metricId}": {
      "schema": { "$ref": "#/entities/DailyCampaignMetric" },
      "description": "Daily campaign metrics inside a workspace."
    },
    "/workspaces/{workspaceId}/content/{contentId}": {
      "schema": { "$ref": "#/entities/ContentItem" },
      "description": "Creative content items inside a workspace."
    },
    "/workspaces/{workspaceId}/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Leads inside a workspace."
    },
    "/workspaces/{workspaceId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customers inside a workspace."
    },
    "/workspaces/{workspaceId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/MarketingOrder" },
      "description": "Marketing orders inside a workspace."
    },
    "/workspaces/{workspaceId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/MarketingExpense" },
      "description": "Marketing expenses inside a workspace."
    },
    "/workspaces/{workspaceId}/planItems/{planItemId}": {
      "schema": { "$ref": "#/entities/MarketingPlanItem" },
      "description": "Marketing calendar plan items inside a workspace."
    },
    "/workspaces/{workspaceId}/auditLogs/{auditLogId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit logs inside a workspace."
    }
  }
