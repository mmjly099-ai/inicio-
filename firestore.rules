rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function authorizedWorkspaceId() {
      return 'ws-af333569a87c9a30972c8da8e6ca4212';
    }

    function isAuthorizedWorkspace(workspaceId) {
      return isValidId(workspaceId) && workspaceId == authorizedWorkspaceId();
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalNumber(data, key) {
      return !(key in data) || data[key] == null || data[key] is number;
    }

    function isValidPlatform(p) {
      return p in ['instagram', 'facebook', 'tiktok', 'whatsapp', 'snapchat', 'twitter', 'google', 'other'];
    }

    function isValidContentType(t) {
      return t in ['reel', 'story', 'post', 'carousel', 'video', 'ad', 'other'];
    }

    function hasValidBaseOwnership(data, docId, workspaceId) {
      return isValidId(docId)
        && data.id == docId
        && isAuthorizedWorkspace(workspaceId)
        && data.workspaceId == workspaceId
        && isValidId(data.ownerUid)
        && data.ownerUid == workspaceId;
    }

    function workspaceExistsAndOwned(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUid == workspaceId;
    }

    function hasImmutableBaseOnUpdate(workspaceId) {
      return incoming().id == existing().id
        && incoming().workspaceId == existing().workspaceId
        && incoming().workspaceId == workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().created_at == existing().created_at
        && incoming().created_by == existing().created_by
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
    }

    // 3. Entity Validation Blueprints
    function isValidWorkspace(data, workspaceId) {
      return data.keys().hasAll(['id', 'ownerUid', 'storeName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'storeName', 'createdAt', 'updatedAt'])
        && isAuthorizedWorkspace(workspaceId)
        && data.id == workspaceId
        && data.ownerUid == workspaceId
        && isValidString(data.storeName, 1, 120);
    }

    function isValidCampaign(data, campaignId, workspaceId) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'workspaceId', 'name', 'platform', 'objective',
          'budget', 'startDate', 'status', 'created_by', 'created_at', 'updated_at',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'workspaceId', 'name', 'platform', 'objective',
          'budget', 'startDate', 'endDate', 'status', 'targetAudience', 'notes',
          'created_by', 'created_at', 'updated_at', 'deleted_at', 'createdAt', 'updatedAt'
        ])
        && hasValidBaseOwnership(data, campaignId, workspaceId)
        && isValidString(data.name, 1, 200)
        && isValidPlatform(data.platform)
        && data.objective in ['awareness', 'messages', 'leads', 'sales', 'retargeting']
        && data.budget is number && data.budget >= 0
        && isValidString(data.startDate, 1, 32)
        && isOptionalString(data, 'endDate', 32)
        && data.status in ['active', 'paused', 'completed', 'draft']
        && isOptionalString(data, 'targetAudience', 500)
        && isOptionalString(data, 'notes', 2000)
        && isValidString(data.created_by, 1, 120)
        && isValidString(data.created_at, 1, 64)
        && isValidString(data.updated_at, 1, 64)
        && isOptionalString(data, 'deleted_at', 64);
    }

    function isValidMetric(data, metricId, workspaceId) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'workspaceId', 'campaignId', 'date', 'spend', 'reach',
          'impressions', 'clicks', 'messages', 'leads', 'newCustomers', 'orders',
          'revenue', 'created_by', 'created_at', 'updated_at', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'workspaceId', 'campaignId', 'date', 'spend', 'reach',
          'impressions', 'clicks', 'messages', 'leads', 'newCustomers', 'orders',
          'revenue', 'notes', 'created_by', 'created_at', 'updated_at', 'deleted_at',
          'createdAt', 'updatedAt'
        ])
        && hasValidBaseOwnership(data, metricId, workspaceId)
        && isValidId(data.campaignId)
        && isValidString(data.date, 1, 32)
        && data.spend is number && data.spend >= 0
        && data.reach is number && data.reach >= 0
        && data.impressions is number && data.impressions >= 0
        && data.clicks is number && data.clicks >= 0
        && data.messages is number && data.messages >= 0
        && data.leads is number && data.leads >= 0
        && data.newCustomers is number && data.newCustomers >= 0
        && data.orders is number && data.orders >= 0
        && data.revenue is number && data.revenue >= 0
        && isOptionalString(data, 'notes', 2000)
        && isValidString(data.created_by, 1, 120)
        && isValidString(data.created_at, 1, 64)
        && isValidString(data.updated_at, 1, 64)
        && isOptionalString(data, 'deleted_at', 64);
    }

    function isValidContentItem(data, contentId, workspaceId) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'workspaceId', 'title', 'platform', 'type', 'hook',
          'publishDate', 'status', 'views', 'reach', 'likes', 'comments',
          'shares', 'saves', 'messages', 'leads', 'orders', 'revenue',
          'created_by', 'created_at', 'updated_at', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'workspaceId', 'title', 'campaignId', 'platform', 'type',
          'hook', 'creator', 'publishDate', 'status', 'views', 'reach', 'likes',
          'comments', 'shares', 'saves', 'messages', 'leads', 'orders', 'revenue',
          'url', 'created_by', 'created_at', 'updated_at', 'deleted_at',
          'createdAt', 'updatedAt'
        ])
        && hasValidBaseOwnership(data, contentId, workspaceId)
        && isValidString(data.title, 1, 250)
        && isOptionalString(data, 'campaignId', 128)
        && isValidPlatform(data.platform)
        && isValidContentType(data.type)
        && isValidString(data.hook, 0, 1000)
        && isOptionalString(data, 'creator', 120)
        && isValidString(data.publishDate, 1, 32)
        && data.status in ['draft', 'scheduled', 'published']
        && data.views is number && data.views >= 0
        && data.reach is number && data.reach >= 0
        && data.likes is number && data.likes >= 0
        && data.comments is number && data.comments >= 0
        && data.shares is number && data.shares >= 0
        && data.saves is number && data.saves >= 0
        && data.messages is number && data.messages >= 0
        && data.leads is number && data.leads >= 0
        && data.orders is number && data.orders >= 0
        && data.revenue is number && data.revenue >= 0
        && isOptionalString(data, 'url', 500)
        && isValidString(data.created_by, 1, 120)
        && isValidString(data.created_at, 1, 64)
        && isValidString(data.updated_at, 1, 64)
        && isOptionalString(data, 'deleted_at', 64);
    }

    function isValidLead(data, leadId, workspaceId) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'workspaceId', 'name', 'phone', 'platform',
          'status', 'created_by', 'created_at', 'updated_at', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'workspaceId', 'name', 'phone', 'platform',
          'campaignId', 'status', 'notes', 'convertedCustomerId',
          'created_by', 'created_at', 'updated_at', 'deleted_at', 'createdAt', 'updatedAt'
        ])
        && hasValidBaseOwnership(data, leadId, workspaceId)
        && isValidString(data.name, 1, 160)
        && isValidString(data.phone, 1, 40)
        && isValidPlatform(data.platform)
        && isOptionalString(data, 'campaignId', 128)
        && data.status in ['new', 'contacted', 'qualified', 'opportunity', 'won', 'lost']
        && isOptionalString(data, 'notes', 2000)
        && isOptionalString(data, 'convertedCustomerId', 128)
        && isValidString(data.created_by, 1, 120)
        && isValidString(data.created_at, 1, 64)
        && isValidString(data.updated_at, 1, 64)
        && isOptionalString(data, 'deleted_at', 64);
    }

    function isValidCustomer(data, customerId, workspaceId) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'workspaceId', 'name', 'phone', 'firstOrderDate',
          'sourcePlatform', 'totalOrders', 'totalSpent', 'customerType',
          'created_by', 'created_at', 'updated_at', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'workspaceId', 'name', 'phone', 'city', 'firstOrderDate',
          'sourceCampaignId', 'sourcePlatform', 'totalOrders', 'totalSpent',
          'customerType', 'notes', 'created_by', 'created_at', 'updated_at',
          'deleted_at', 'createdAt', 'updatedAt'
        ])
        && hasValidBaseOwnership(data, customerId, workspaceId)
        && isValidString(data.name, 1, 160)
        && isValidString(data.phone, 1, 40)
        && isOptionalString(data, 'city', 100)
        && isValidString(data.firstOrderDate, 1, 32)
        && isOptionalString(data, 'sourceCampaignId', 128)
        && isValidPlatform(data.sourcePlatform)
        && data.totalOrders is number && data.totalOrders >= 0
        && data.totalSpent is number && data.totalSpent >= 0
        && data.customerType in ['new', 'returning']
        && isOptionalString(data, 'notes', 2000)
        && isValidString(data.created_by, 1, 120)
        && isValidString(data.created_at, 1, 64)
        && isValidString(data.updated_at, 1, 64)
        && isOptionalString(data, 'deleted_at', 64);
    }

    function isValidOrder(data, orderId, workspaceId) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'workspaceId', 'orderNumber', 'customerId',
          'customerName', 'platform', 'orderDate', 'amount', 'status',
          'created_by', 'created_at', 'updated_at', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'workspaceId', 'orderNumber', 'customerId',
          'customerName', 'campaignId', 'platform', 'orderDate', 'amount',
          'cost', 'profit', 'status', 'notes', 'created_by', 'created_at',
          'updated_at', 'deleted_at', 'createdAt', 'updatedAt'
        ])
        && hasValidBaseOwnership(data, orderId, workspaceId)
        && isValidString(data.orderNumber, 1, 64)
        && isValidId(data.customerId)
        && isValidString(data.customerName, 1, 160)
        && isOptionalString(data, 'campaignId', 128)
        && isValidPlatform(data.platform)
        && isValidString(data.orderDate, 1, 32)
        && data.amount is number && data.amount >= 0
        && isOptionalNumber(data, 'cost')
        && isOptionalNumber(data, 'profit')
        && data.status in ['new', 'processing', 'delivered', 'returned']
        && isOptionalString(data, 'notes', 2000)
        && isValidString(data.created_by, 1, 120)
        && isValidString(data.created_at, 1, 64)
        && isValidString(data.updated_at, 1, 64)
        && isOptionalString(data, 'deleted_at', 64);
    }

    function isValidExpense(data, expenseId, workspaceId) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'workspaceId', 'title', 'category', 'amount',
          'expenseDate', 'paymentMethod', 'created_by', 'created_at',
          'updated_at', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'workspaceId', 'title', 'category', 'amount',
          'expenseDate', 'campaignId', 'paymentMethod', 'notes', 'created_by',
          'created_at', 'updated_at', 'deleted_at', 'createdAt', 'updatedAt'
        ])
        && hasValidBaseOwnership(data, expenseId, workspaceId)
        && isValidString(data.title, 1, 200)
        && data.category in ['paid_ads', 'content_design', 'tools_software', 'influencers', 'other']
        && data.amount is number && data.amount >= 0
        && isValidString(data.expenseDate, 1, 32)
        && isOptionalString(data, 'campaignId', 128)
        && isValidString(data.paymentMethod, 1, 100)
        && isOptionalString(data, 'notes', 2000)
        && isValidString(data.created_by, 1, 120)
        && isValidString(data.created_at, 1, 64)
        && isValidString(data.updated_at, 1, 64)
        && isOptionalString(data, 'deleted_at', 64);
    }

    function isValidPlanItem(data, planItemId, workspaceId) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'workspaceId', 'date', 'title', 'platform',
          'hook', 'contentType', 'assignedTo', 'status', 'created_by',
          'created_at', 'updated_at', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'workspaceId', 'date', 'time', 'title', 'platform',
          'campaignId', 'hook', 'contentType', 'assignedTo', 'status', 'priority',
          'targetGoal', 'notes', 'created_by', 'created_at', 'updated_at',
          'deleted_at', 'createdAt', 'updatedAt'
        ])
        && hasValidBaseOwnership(data, planItemId, workspaceId)
        && isValidString(data.date, 1, 32)
        && isOptionalString(data, 'time', 16)
        && isValidString(data.title, 1, 250)
        && isValidPlatform(data.platform)
        && isOptionalString(data, 'campaignId', 128)
        && isValidString(data.hook, 0, 1000)
        && isValidContentType(data.contentType)
        && isValidString(data.assignedTo, 1, 120)
        && data.status in ['idea', 'in_progress', 'ready', 'published']
        && (!('priority' in data) || data.priority == null || data.priority in ['high', 'medium', 'low'])
        && isOptionalString(data, 'targetGoal', 250)
        && isOptionalString(data, 'notes', 2000)
        && isValidString(data.created_by, 1, 120)
        && isValidString(data.created_at, 1, 64)
        && isValidString(data.updated_at, 1, 64)
        && isOptionalString(data, 'deleted_at', 64);
    }

    function isValidAuditLog(data, auditLogId, workspaceId) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'workspaceId', 'userName', 'userRole', 'action',
          'targetType', 'targetId', 'targetTitle', 'details', 'timestamp', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'workspaceId', 'userName', 'userRole', 'action',
          'targetType', 'targetId', 'targetTitle', 'details', 'timestamp', 'createdAt'
        ])
        && hasValidBaseOwnership(data, auditLogId, workspaceId)
        && isValidString(data.userName, 1, 120)
        && data.userRole in ['admin', 'marketer', 'viewer']
        && data.action in ['create', 'update', 'soft_delete', 'restore', 'convert_lead', 'toggle_demo', 'import_backup']
        && isValidString(data.targetType, 1, 80)
        && isValidString(data.targetId, 1, 128)
        && isValidString(data.targetTitle, 1, 250)
        && isValidString(data.details, 1, 1000)
        && isValidString(data.timestamp, 1, 64);
    }

    // 4. Connection check endpoint (get-only on fixed test document)
    match /test/connection {
      allow get: if true;
    }

    // 5. Keyed Store Workspace & Nested Marketing Collections
    match /workspaces/{workspaceId} {
      allow get: if isAuthorizedWorkspace(workspaceId) && (resource == null || existing().ownerUid == workspaceId);
      allow list: if false;
      allow create: if isAuthorizedWorkspace(workspaceId)
        && isValidWorkspace(incoming(), workspaceId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAuthorizedWorkspace(workspaceId)
        && isValidWorkspace(incoming(), workspaceId)
        && existing().ownerUid == workspaceId
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['storeName', 'updatedAt']);
      allow delete: if false;

      // Campaigns
      match /campaigns/{campaignId} {
        allow get: if isAuthorizedWorkspace(workspaceId) && isValidId(campaignId)
          && (resource == null || existing().ownerUid == workspaceId);
        allow list: if isAuthorizedWorkspace(workspaceId) && existing().ownerUid == workspaceId;
        allow create: if isAuthorizedWorkspace(workspaceId) && isValidId(campaignId)
          && isValidCampaign(incoming(), campaignId, workspaceId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && workspaceExistsAndOwned(workspaceId);
        allow update: if isAuthorizedWorkspace(workspaceId) && isValidId(campaignId)
          && isValidCampaign(incoming(), campaignId, workspaceId)
          && existing().ownerUid == workspaceId
          && hasImmutableBaseOnUpdate(workspaceId)
          && (
            (
              existing().status != 'completed' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'platform', 'objective', 'budget', 'startDate', 'endDate',
                'status', 'targetAudience', 'notes', 'updated_at', 'deleted_at', 'updatedAt'
              ])
            ) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['deleted_at', 'updated_at', 'updatedAt'])
          );
        allow delete: if isAuthorizedWorkspace(workspaceId) && isValidId(campaignId)
          && existing().ownerUid == workspaceId;
      }

      // Daily Metrics
      match /metrics/{metricId} {
        allow get: if isAuthorizedWorkspace(workspaceId) && isValidId(metricId)
          && (resource == null || existing().ownerUid == workspaceId);
        allow list: if isAuthorizedWorkspace(workspaceId) && existing().ownerUid == workspaceId;
        allow create: if isAuthorizedWorkspace(workspaceId) && isValidId(metricId)
          && isValidMetric(incoming(), metricId, workspaceId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && workspaceExistsAndOwned(workspaceId);
        allow update: if isAuthorizedWorkspace(workspaceId) && isValidId(metricId)
          && isValidMetric(incoming(), metricId, workspaceId)
          && existing().ownerUid == workspaceId
          && hasImmutableBaseOnUpdate(workspaceId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'campaignId', 'date', 'spend', 'reach', 'impressions', 'clicks',
            'messages', 'leads', 'newCustomers', 'orders', 'revenue', 'notes',
            'updated_at', 'deleted_at', 'updatedAt'
          ]);
        allow delete: if isAuthorizedWorkspace(workspaceId) && isValidId(metricId)
          && existing().ownerUid == workspaceId;
      }

      // Content Items
      match /content/{contentId} {
        allow get: if isAuthorizedWorkspace(workspaceId) && isValidId(contentId)
          && (resource == null || existing().ownerUid == workspaceId);
        allow list: if isAuthorizedWorkspace(workspaceId) && existing().ownerUid == workspaceId;
        allow create: if isAuthorizedWorkspace(workspaceId) && isValidId(contentId)
          && isValidContentItem(incoming(), contentId, workspaceId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && workspaceExistsAndOwned(workspaceId);
        allow update: if isAuthorizedWorkspace(workspaceId) && isValidId(contentId)
          && isValidContentItem(incoming(), contentId, workspaceId)
          && existing().ownerUid == workspaceId
          && hasImmutableBaseOnUpdate(workspaceId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'campaignId', 'platform', 'type', 'hook', 'creator',
            'publishDate', 'status', 'views', 'reach', 'likes', 'comments',
            'shares', 'saves', 'messages', 'leads', 'orders', 'revenue', 'url',
            'updated_at', 'deleted_at', 'updatedAt'
          ]);
        allow delete: if isAuthorizedWorkspace(workspaceId) && isValidId(contentId)
          && existing().ownerUid == workspaceId;
      }

      // Leads (Key-gated)
      match /leads/{leadId} {
        allow get: if isAuthorizedWorkspace(workspaceId) && isValidId(leadId)
          && (resource == null || existing().ownerUid == workspaceId);
        allow list: if isAuthorizedWorkspace(workspaceId) && existing().ownerUid == workspaceId;
        allow create: if isAuthorizedWorkspace(workspaceId) && isValidId(leadId)
          && isValidLead(incoming(), leadId, workspaceId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && workspaceExistsAndOwned(workspaceId);
        allow update: if isAuthorizedWorkspace(workspaceId) && isValidId(leadId)
          && isValidLead(incoming(), leadId, workspaceId)
          && existing().ownerUid == workspaceId
          && hasImmutableBaseOnUpdate(workspaceId)
          && (
            (
              existing().status != 'won' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'phone', 'platform', 'campaignId', 'status', 'notes',
                'convertedCustomerId', 'updated_at', 'deleted_at', 'updatedAt'
              ])
            ) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['deleted_at', 'updated_at', 'updatedAt'])
          );
        allow delete: if isAuthorizedWorkspace(workspaceId) && isValidId(leadId)
          && existing().ownerUid == workspaceId;
      }

      // Customers (Key-gated)
      match /customers/{customerId} {
        allow get: if isAuthorizedWorkspace(workspaceId) && isValidId(customerId)
          && (resource == null || existing().ownerUid == workspaceId);
        allow list: if isAuthorizedWorkspace(workspaceId) && existing().ownerUid == workspaceId;
        allow create: if isAuthorizedWorkspace(workspaceId) && isValidId(customerId)
          && isValidCustomer(incoming(), customerId, workspaceId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && workspaceExistsAndOwned(workspaceId);
        allow update: if isAuthorizedWorkspace(workspaceId) && isValidId(customerId)
          && isValidCustomer(incoming(), customerId, workspaceId)
          && existing().ownerUid == workspaceId
          && hasImmutableBaseOnUpdate(workspaceId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'phone', 'city', 'firstOrderDate', 'sourceCampaignId',
            'sourcePlatform', 'totalOrders', 'totalSpent', 'customerType',
            'notes', 'updated_at', 'deleted_at', 'updatedAt'
          ]);
        allow delete: if isAuthorizedWorkspace(workspaceId) && isValidId(customerId)
          && existing().ownerUid == workspaceId;
      }

      // Marketing Orders
      match /orders/{orderId} {
        allow get: if isAuthorizedWorkspace(workspaceId) && isValidId(orderId)
          && (resource == null || existing().ownerUid == workspaceId);
        allow list: if isAuthorizedWorkspace(workspaceId) && existing().ownerUid == workspaceId;
        allow create: if isAuthorizedWorkspace(workspaceId) && isValidId(orderId)
          && isValidOrder(incoming(), orderId, workspaceId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && workspaceExistsAndOwned(workspaceId);
        allow update: if isAuthorizedWorkspace(workspaceId) && isValidId(orderId)
          && isValidOrder(incoming(), orderId, workspaceId)
          && existing().ownerUid == workspaceId
          && hasImmutableBaseOnUpdate(workspaceId)
          && (
            (
              existing().status != 'delivered' &&
              existing().status != 'returned' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'orderNumber', 'customerId', 'customerName', 'campaignId',
                'platform', 'orderDate', 'amount', 'cost', 'profit', 'status',
                'notes', 'updated_at', 'deleted_at', 'updatedAt'
              ])
            ) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['deleted_at', 'updated_at', 'updatedAt'])
          );
        allow delete: if isAuthorizedWorkspace(workspaceId) && isValidId(orderId)
          && existing().ownerUid == workspaceId;
      }

      // Marketing Expenses
      match /expenses/{expenseId} {
        allow get: if isAuthorizedWorkspace(workspaceId) && isValidId(expenseId)
          && (resource == null || existing().ownerUid == workspaceId);
        allow list: if isAuthorizedWorkspace(workspaceId) && existing().ownerUid == workspaceId;
        allow create: if isAuthorizedWorkspace(workspaceId) && isValidId(expenseId)
          && isValidExpense(incoming(), expenseId, workspaceId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && workspaceExistsAndOwned(workspaceId);
        allow update: if isAuthorizedWorkspace(workspaceId) && isValidId(expenseId)
          && isValidExpense(incoming(), expenseId, workspaceId)
          && existing().ownerUid == workspaceId
          && hasImmutableBaseOnUpdate(workspaceId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'category', 'amount', 'expenseDate', 'campaignId',
            'paymentMethod', 'notes', 'updated_at', 'deleted_at', 'updatedAt'
          ]);
        allow delete: if isAuthorizedWorkspace(workspaceId) && isValidId(expenseId)
          && existing().ownerUid == workspaceId;
      }

      // Marketing Plan Items
      match /planItems/{planItemId} {
        allow get: if isAuthorizedWorkspace(workspaceId) && isValidId(planItemId)
          && (resource == null || existing().ownerUid == workspaceId);
        allow list: if isAuthorizedWorkspace(workspaceId) && existing().ownerUid == workspaceId;
        allow create: if isAuthorizedWorkspace(workspaceId) && isValidId(planItemId)
          && isValidPlanItem(incoming(), planItemId, workspaceId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && workspaceExistsAndOwned(workspaceId);
        allow update: if isAuthorizedWorkspace(workspaceId) && isValidId(planItemId)
          && isValidPlanItem(incoming(), planItemId, workspaceId)
          && existing().ownerUid == workspaceId
          && hasImmutableBaseOnUpdate(workspaceId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'date', 'time', 'title', 'platform', 'campaignId', 'hook',
            'contentType', 'assignedTo', 'status', 'priority', 'targetGoal',
            'notes', 'updated_at', 'deleted_at', 'updatedAt'
          ]);
        allow delete: if isAuthorizedWorkspace(workspaceId) && isValidId(planItemId)
          && existing().ownerUid == workspaceId;
      }

      // Audit Logs (Append-only)
      match /auditLogs/{auditLogId} {
        allow get: if isAuthorizedWorkspace(workspaceId) && isValidId(auditLogId)
          && (resource == null || existing().ownerUid == workspaceId);
        allow list: if isAuthorizedWorkspace(workspaceId) && existing().ownerUid == workspaceId;
        allow create: if isAuthorizedWorkspace(workspaceId) && isValidId(auditLogId)
          && isValidAuditLog(incoming(), auditLogId, workspaceId)
          && incoming().createdAt == request.time
          && workspaceExistsAndOwned(workspaceId);
        allow update, delete: if false;
      }
    }
  }
}
